      {
        "label": "Studio",
        "href": "https://monkeygun.com/app"
      },
      {
        "label": "Pricing",
        "href": "https://monkeygun.com/pricing"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get an API key",
      "href": "https://monkeygun.com/login?next=/app/settings"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Start here",
            "pages": [
              "introduction",
              "quickstart",
              "packages"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/videos-and-statuses",
              "concepts/media-and-keys",
              "concepts/credits-and-quotes",
              "concepts/brand-and-packs",
              "concepts/channels-shows-kits"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/data-to-video",
              "guides/webhooks-and-polling",
              "guides/async-jobs",
              "guides/authored-scripts",
              "guides/embedded-studio",
              "guides/upload-and-brand-pass",
              "guides/scheduled-shows"
            ]
          },
          {
            "group": "Data schemas",
            "pages": [
              "schemas/overview",
              "schemas/token-snapshot",
              "schemas/pool-snapshot",
              "schemas/wallet-snapshot",
              "schemas/flow-snapshot"
            ]
          },
          {
            "group": "Use cases",
            "pages": [
              "use-cases/overview",
              "use-cases/url-to-video",
              "use-cases/footage-to-video",
              "use-cases/other-data"
            ]
          },
          {
            "group": "Examples",
            "pages": [
              "examples/tokenslop",
              "examples/nansen-shows"
            ]
