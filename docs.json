          {
            "group": "Reference",
            "pages": [
              "errors",
              "limits",
              "changelog"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "openapi": "openapi.json"
      }
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/monkeygun",
      "github": "https://github.com/arambarnett/nansen-shows"
    }
  },
  "api": {
    "baseUrl": "https://api.monkeygun.com/v1",
    "auth": {
      "method": "bearer"
    },
    "playground": {
      "display": "interactive"
    }
