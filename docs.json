{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Monkeygun",
  "description": "Data in, videos out. The video engine for exchanges, protocols and data companies.",
  "colors": {
    "primary": "#6E8F0A",
    "light": "#C7F24C",
    "dark": "#0B0C0F"
  },
  "logo": {
    "light": "/images/logo-dark.png",
    "dark": "/images/logo-light.png",
    "href": "https://monkeygun.com"
  },
  "favicon": "/images/favicon.png",
